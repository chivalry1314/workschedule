{
  "version": "2.0",
  "envId": "{{env.CLOUDBASE_ENV_ID}}",
  "functionRoot": "./",
  "functions": [
    {
      "name": "workschedule-api",
      "handler": "dist/serverless/scf-handler.main_handler",
      "runtime": "Nodejs20.19",
      "timeout": 30,
      "memorySize": 512,
      "envVariables": {
        "CLOUDBASE_ENV_ID": "{{env.CLOUDBASE_ENV_ID}}",
        "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}",
        "JWT_SECRET": "{{env.JWT_SECRET}}",
        "JWT_EXPIRES_IN": "{{env.JWT_EXPIRES_IN}}"
      }
    }
  ]
}
