{
  "version": "2.0",
  "envId": "your-env-id",
  "framework": {
    "name": "workschedule-api",
    "plugins": {
      "server": {
        "use": "@cloudbase/framework-plugin-container",
        "inputs": {
          "serviceName": "workschedule-api",
          "servicePath": "/api",
          "containerPort": 80,
          "localPath": "./",
          "dockerfilePath": "./Dockerfile",
          "ignore": [".git", "node_modules", "dist", ".env", ".env.*"],
          "envVariables": {
            "CLOUDBASE_ENV_ID": "{{env.CLOUDBASE_ENV_ID}}",
            "CLOUDBASE_APIKEY": "{{env.CLOUDBASE_APIKEY}}",
            "JWT_SECRET": "{{env.JWT_SECRET}}",
            "JWT_EXPIRES_IN": "{{env.JWT_EXPIRES_IN}}"
          }
        }
      }
    }
  }
}
