# 数据库配置
# 方式一（阿里云服务器本地 SQLite，适合 99 元/年低配 ECS）：
DATABASE_URL="sqlite:./data/workschedule.db"

# 方式二（保留腾讯云 CloudBase PostgreSQL）：
# 取消下面两行注释，并删除或注释掉上面的 DATABASE_URL
# CLOUDBASE_ENV_ID="your-env-id"
# CLOUDBASE_APIKEY="your-api-key"

# JWT 配置
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="2h"

# 服务端口
PORT=3000
