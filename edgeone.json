{
  "buildCommand": "npm run build:edgeone",
  "outputDirectory": "./workschedule-web/dist",
  "installCommand": "npm install",
  "nodeVersion": "22.11.0",
  "rewrites": [
    {
      "source": "/api/*",
      "destination": "/api/:splat"
    },
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 60
    }
  }
}
