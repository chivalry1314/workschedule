{
  "buildCommand": "npm run build:edgeone",
  "outputDirectory": "./workschedule-web/dist",
  "installCommand": "npm install",
  "nodeVersion": "22.11.0",
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "cloudFunctions": {
    "externalNodeModules": [
      "express",
      "@nestjs/microservices",
      "@nestjs/websockets",
      "@cloudbase/js-sdk",
      "ws"
    ],
    "nodejs": {
      "externalNodeModules": [
        "express",
        "@nestjs/microservices",
        "@nestjs/websockets",
        "@cloudbase/js-sdk",
        "ws"
      ]
    }
  }
}
