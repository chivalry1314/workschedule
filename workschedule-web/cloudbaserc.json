{
  "version": "2.0",
  "envId": "your-env-id",
  "framework": {
    "name": "workschedule-web",
    "plugins": {
      "client": {
        "use": "@cloudbase/framework-plugin-website",
        "inputs": {
          "codeRoot": "dist",
          "entry": "/index.html",
          "ignores": ["node_modules"],
          "customDomains": [
            {
              "domain": "your-domain.com",
              "dnsType": "cname"
            }
          ]
        }
      }
    }
  }
}
